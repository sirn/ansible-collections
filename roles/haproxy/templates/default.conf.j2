#jinja2: trim_blocks:False
global
    maxconn  {{ haproxy_maxconn | default(4000) }}
    log      stdout format raw local0 debug

    ssl-default-bind-ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384
    ssl-default-bind-ciphersuites TLS_AES_128_GCM_SHA256:TLS_AES_256_GCM_SHA384:TLS_CHACHA20_POLY1305_SHA256
    ssl-default-bind-options prefer-client-ciphers no-sslv3 no-tlsv10 no-tlsv11

    ssl-default-server-ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384
    ssl-default-server-ciphersuites TLS_AES_128_GCM_SHA256:TLS_AES_256_GCM_SHA384:TLS_CHACHA20_POLY1305_SHA256
    ssl-default-server-options no-sslv3 no-tlsv10 no-tlsv11

    # curl https://ssl-config.mozilla.org/ffdhe2048.txt > /path/to/dhparam
    ssl-dh-param-file /usr/local/etc/ssl/ffdhe2048.txt

defaults
    log      global
    timeout  connect {{ haproxy_timeout_connect | default(10000) }}
    timeout  server  {{ haproxy_timeout_server | default(600000) }}
    timeout  client  {{ haproxy_timeout_client | default(600000) }}
    timeout  queue   {{ haproxy_timeout_queue | default(60000) }}
{%- if haproxy_resolvers %}
{%- for resolver in haproxy_resolvers %}

resolvers {{ resolver.name }}
{%- for ns in resolver.nameservers %}
    nameserver {{ ns.name }} {{ ns.address }}
{%- endfor %}
{%- if "resolve_retries" in resolver %}
    resolve_retries       {{ resolver.resolve_retries }}
{%- endif %}
{%- if "timeout_retry" in resolver %}
    timeout retry         {{ resolver.timeout_retry }}
{%- endif %}
{%- if "hold_valid" in resolver %}
    hold valid            {{ resolver.hold_valid }}
{%- endif %}
{%- endfor %}
{%- endif %}
{%- if haproxy_stats %}

frontend stats
    mode   http
{%- for bind in haproxy_stats.binds %}
    bind   {{ bind.address }}{% if "flags" in bind %} {{ bind.flags | join(" ") }}{% endif %}
{%- endfor %}
    stats  enable
    stats  uri /
{%- for option in haproxy_stats.options %}
    stats  {{ option }}
{%- endfor %}
{%- endif %}
{%- for frontend in haproxy_frontends %}

frontend {{ frontend.name }}
    mode   {{ frontend.mode }}
{%- for bind in frontend.binds %}
    bind   {{ bind.address }}{% if "flags" in bind %} {{ bind.flags | join(" ") }}{% endif %}
{%- endfor %}
{%- if "config" in frontend %}
    {{ frontend.config | trim | indent(4) }}
{%- endif %}
{%- if "http_request" in frontend %}
{%- for httpreq in frontend.http_request %}
    http-request {{ httpreq }}
{%- endfor %}
{%- endif %}
{%- if "backends" in frontend %}
{%- for backend in frontend.backends %}
{%- for acl in backend.acls %}
    acl          {{ "%-15s" | format(acl.acl) }} {% if frontend.mode == "http" %}hdr(host){% else %}ssl_fc_sni{% endif %}{% if "mode" in acl and acl.mode %} -m {{ acl.mode }}{% endif %} -i {{ acl.domain }}
{%- endfor %}
{%- if "allowed_sources" in backend and backend.allowed_sources %}
    acl          {{ "%-15s" | format(backend.backend ~ "-allowed") }} src {{ backend.allowed_sources | join(" ") }}
{%- endif %}
{%- endfor %}
{%- for backend in frontend.backends %}
{%- for acl in backend.acls %}
{%- if "allowed_sources" in backend and backend.allowed_sources %}
    use_backend  {{ "%-15s" | format(backend.backend) }} if {{ acl.acl }} {{ backend.backend }}-allowed
{%- else %}
    use_backend  {{ "%-15s" | format(backend.backend) }} if {{ acl.acl }}
{%- endif %}
{%- endfor %}
{%- endfor %}
{%- endif %}
    default_backend {% if "default_backend" in frontend %}{{ frontend.default_backend }}{% else %}default-http{% endif %}
{%- endfor %}
{%- for backend in haproxy_backends %}

backend {{ backend.name }}
    fullconn  {{ backend.fullconn | default(4000) }}
    mode      {{ backend.mode }}
    balance   roundrobin
    option    tcp-check
{%- if "options" in backend %}
{%- for option in backend.options %}
    option    {{ option }}
{%- endfor %}
{%- endif %}
    server    {{ "%-15s" | format(backend.hostname) }} {{ backend.address }}{% if "port" in backend %}:{{ backend.port }}{% endif %}{% if "resolver" in backend %} resolvers {{ backend.resolver }}{% endif %}{% if "flags" in backend %} {{ backend.flags | join(" ") }}{% endif %}
{%- endfor %}

backend default-http
    mode         http
    http-request return status 404 content-type "text/plain" string "backend not found"
