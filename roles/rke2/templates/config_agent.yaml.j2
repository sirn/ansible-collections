server: {{ rke2_server_url }}
token: {{ rke2_token }}
{% if rke2_agent_node_labels %}
node-label:
{% for label in rke2_agent_node_labels %}
  - "{{ label }}"
{% endfor %}
{% endif %}
{% if rke2_agent_node_taints %}
node-taint:
{% for taint in rke2_agent_node_taints %}
  - "{{ taint }}"
{% endfor %}
{% endif %}
{% for key, value in rke2_extra_args.items() %}
{{ key }}: {{ value }}
{% endfor %}